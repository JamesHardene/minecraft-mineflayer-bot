# Template only. Do not put production passwords or Microsoft tokens here.
# The installer writes the real file to /etc/minecraft-bot/minecraft-bot.env.

# Required connection settings
MC_HOST=play.example.com
MC_PORT=25565
MC_USERNAME=BotName
MC_SERVER_NAME=Example Minecraft Server

# Authentication: offline requires an authorized offline-mode server;
# microsoft uses Mineflayer device-code authentication.
MC_AUTH=offline

# Leave empty for Mineflayer protocol auto-detection, or set a supported version.
MC_VERSION=

# Optional server-side login plugin settings. This is not a Microsoft password.
# Leave MC_LOGIN_PASSWORD empty to disable automatic /l login.
MC_LOGIN_PASSWORD=
MC_LOGIN_DELAY_SECONDS=3
MC_LOGIN_COMMAND=/l

# Reconnect and status behavior
MC_RECONNECT_INITIAL_SECONDS=5
MC_RECONNECT_MAX_SECONDS=300
MC_RECONNECT_JITTER_SECONDS=3
MC_STATUS_INTERVAL_SECONDS=3
MC_ANTIAFK=true
MC_ANTIAFK_INTERVAL_SECONDS=45

# Runtime paths are managed by systemd and the installer. Keep these defaults.
MCBOT_DATA_DIR=/var/lib/minecraft-bot
MCBOT_STATUS_FILE=/var/lib/minecraft-bot/status.json
MCBOT_CONTROL_SOCKET=/run/minecraft-bot/control.sock
MCBOT_CONTROL_MAX_TEXT=256
MCBOT_SERVICE_NAME=minecraft-bot.service
MCBOT_CONFIG_ADMIN=/usr/local/sbin/mcbot-config
MC_PROFILES_FOLDER=/var/lib/minecraft-bot/auth

# The mcbot menu can edit the connection and login fields above.
# It does not edit the MCBOT_* paths or authentication cache path.
